{
  "id": "PLACEHOLDER",
  "elType": "container",
  "settings": {
    "content_width": "boxed",
    "flex_direction": "column",
    "flex_align_items": "stretch",
    "flex_gap": { "size": 24, "unit": "px", "column": "24", "row": "24", "isLinked": true },
    "padding": { "unit": "px", "top": "60", "right": "20", "bottom": "60", "left": "20", "isLinked": false }
  },
  "elements": [
    {
      "id": "PLACEHOLDER",
      "elType": "widget",
      "widgetType": "heading",
      "settings": {
        "title": "__CONTENT_HEADLINE__",
        "header_size": "h2",
        "size": "xl",
        "align": "center",
        "__globals__": {
          "title_color": "globals/colors?id=text",
          "typography_typography": "globals/typography?id=primary"
        }
      },
      "elements": []
    },
    {
      "id": "PLACEHOLDER",
      "elType": "widget",
      "widgetType": "posts",
      "settings": {
        "posts_post_type": "__CONTENT_POST_TYPE__",
        "posts_posts_per_page": 3,
        "classic_columns": "3",
        "classic_columns_tablet": "2",
        "classic_columns_mobile": "1",
        "classic_show_image": "yes",
        "classic_image_position": "top",
        "classic_image_size": "medium_large",
        "classic_show_title": "yes",
        "classic_show_excerpt": "yes",
        "classic_excerpt_length": 20,
        "classic_show_date": "yes",
        "classic_show_meta_data": [ "date" ],
        "classic_columns_gap": { "size": 24, "unit": "px" },
        "classic_rows_gap": { "size": 32, "unit": "px" }
      },
      "elements": []
    },
    {
      "id": "PLACEHOLDER",
      "elType": "widget",
      "widgetType": "button",
      "settings": {
        "text": "__CONTENT_CTA_TEXT__",
        "link": { "url": "__CONTENT_CTA_URL__", "is_external": "", "nofollow": "" },
        "size": "md",
        "align": "center",
        "border_radius": { "unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": true },
        "button_text_color": "#FFFFFF",
        "__globals__": {
          "background_color": "globals/colors?id=primary"
        }
      },
      "elements": []
    }
  ],
  "isInner": false
}
