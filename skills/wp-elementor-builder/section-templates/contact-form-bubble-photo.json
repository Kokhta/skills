{
  "id": "PLACEHOLDER",
  "elType": "container",
  "settings": {
    "content_width": "boxed",
    "flex_direction": "row",
    "flex_align_items": "stretch",
    "flex_gap": { "size": 0, "unit": "px", "column": "0", "row": "0", "isLinked": true },
    "flex_direction_mobile": "column",
    "padding": { "unit": "px", "top": "60", "right": "20", "bottom": "60", "left": "20", "isLinked": false },
    "border_radius": { "unit": "px", "top": "32", "right": "32", "bottom": "32", "left": "32", "isLinked": true },
    "_padding": { "unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true }
  },
  "elements": [
    {
      "id": "PLACEHOLDER",
      "elType": "container",
      "settings": {
        "width": { "unit": "%", "size": 50 },
        "width_mobile": { "unit": "%", "size": 100 },
        "flex_direction": "column",
        "flex_justify_content": "flex-end",
        "flex_align_items": "center",
        "background_background": "classic",
        "__globals__": { "background_color": "globals/colors?id=primary" },
        "border_radius": { "unit": "px", "top": "32", "right": "0", "bottom": "0", "left": "32", "isLinked": false }
      },
      "elements": [
        {
          "id": "PLACEHOLDER",
          "elType": "widget",
          "widgetType": "image",
          "settings": {
            "image": { "id": "__ASSET_PERSON_PHOTO__", "url": "__ASSET_PERSON_PHOTO_URL__" },
            "image_size": "full",
            "align": "center"
          },
          "elements": []
        }
      ],
      "isInner": true
    },
    {
      "id": "PLACEHOLDER",
      "elType": "container",
      "settings": {
        "width": { "unit": "%", "size": 50 },
        "width_mobile": { "unit": "%", "size": 100 },
        "flex_direction": "column",
        "flex_justify_content": "center",
        "padding": { "unit": "px", "top": "60", "right": "60", "bottom": "60", "left": "60", "isLinked": false },
        "padding_mobile": { "unit": "px", "top": "40", "right": "20", "bottom": "40", "left": "20", "isLinked": false },
        "background_background": "classic",
        "background_color": "#000000",
        "border_radius": { "unit": "px", "top": "0", "right": "32", "bottom": "32", "left": "0", "isLinked": false },
        "flex_gap": { "size": 24, "unit": "px", "column": "24", "row": "24", "isLinked": true }
      },
      "elements": [
        {
          "id": "PLACEHOLDER",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Contacto",
            "header_size": "h1",
            "size": "xxl",
            "align": "left",
            "__globals__": {
              "title_color": "globals/colors?id=primary",
              "typography_typography": "globals/typography?id=primary"
            }
          },
          "elements": []
        },
        {
          "id": "PLACEHOLDER",
          "elType": "widget",
          "widgetType": "form",
          "settings": {
            "form_name": "Contact",
            "form_fields": [
              { "_id": "name",    "field_label": "Nombre",   "field_type": "text", "placeholder": "Nombre",   "required": "true", "width": "100" },
              { "_id": "lastname","field_label": "Apellido", "field_type": "text", "placeholder": "Apellido", "required": "true", "width": "100" },
              { "_id": "email",   "field_label": "Correo",   "field_type": "email","placeholder": "Correo",   "required": "true", "width": "100" },
              { "_id": "phone",   "field_label": "Teléfono", "field_type": "tel",  "placeholder": "Teléfono", "required": "false","width": "100" },
              { "_id": "message", "field_label": "Mensaje",  "field_type": "textarea","placeholder": "Mensaje","required": "true","width": "100","rows": 4 }
            ],
            "button_text": "Enviar",
            "button_size": "md",
            "button_align": "left",
            "email_to": "__CONTENT_EMAIL_TO__",
            "email_subject": "Nuevo contacto",
            "success_message": "Gracias por mandar tus datos!",
            "field_text_color": "#FFFFFF",
            "field_background_color": "rgba(0,0,0,0)",
            "field_border_color": "#3B82F6",
            "label_text_color": "#3B82F6",
            "__globals__": {
              "button_background_color": "globals/colors?id=primary"
            }
          },
          "elements": []
        }
      ],
      "isInner": true
    }
  ],
  "isInner": false
}
